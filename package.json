{
  "name": "deepsearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3333",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3333",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "infra:up": "docker compose -f ops/docker/compose.yaml up -d redis-content redis-control",
    "infra:down": "docker compose -f ops/docker/compose.yaml down",
    "deploy:up": "docker compose -f ops/docker/compose.yaml --profile app up -d --build",
    "test:infra:up": "docker compose -f ops/docker/compose.test.yaml up -d",
    "test:infra:down": "docker compose -f ops/docker/compose.test.yaml down",
    "control:status": "node --env-file-if-exists=.env ops/scripts/control.mjs status",
    "control:approve": "node --env-file-if-exists=.env ops/scripts/control.mjs approve"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
