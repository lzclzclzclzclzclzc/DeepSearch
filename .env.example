# Only the server reads these variables. Never use NEXT_PUBLIC_ for secrets.
# Optional site-wide default; visitors can also set a personal key in Settings.
DEEPSEEK_API_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3333
REDIS_CONTENT_URL=redis://127.0.0.1:6381
REDIS_CONTROL_URL=redis://127.0.0.1:6380
# Estimated price per paid Search request, in millionths of one CNY.
# There is no daily spending cap.
SEARCH_COST_MICROYUAN=5000
FETCH_COST_MICROYUAN=5000
FETCH_QPS=20
# Manual AI summaries use the same configured API key. Prices are CNY / million tokens.
# Conservative peak estimates; adjust to the current supplier price for your model.
SUMMARY_MODEL=deepseek-flash
SUMMARY_INPUT_PRICE=2
SUMMARY_CACHED_INPUT_PRICE=0.04
SUMMARY_OUTPUT_PRICE=8
SUMMARY_CONCURRENCY=20
SUMMARY_QPS=20
SUMMARY_TIMEOUT_MS=30000
SEARCH_QPS=80
SESSION_SEARCHES_PER_MINUTE=20
IP_SEARCHES_PER_MINUTE=60
SEARCH_TIMEOUT_MS=6000
SEARCH_DEADLINE_MS=10000
SNAPSHOT_TTL_SECONDS=1800
MAX_SESSION_SNAPSHOTS=20
# Set only behind a reverse proxy that REPLACES x-real-ip.
# Without a trusted client IP, session limits and upstream QPS limits still apply.
TRUST_PROXY=false
# Optional bearer token protecting /api/metrics. Keep it private.
METRICS_TOKEN=
