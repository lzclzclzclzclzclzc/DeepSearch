# Only the server reads these variables. Never use NEXT_PUBLIC_ for secrets.
# Optional site-wide default; visitors can also set a personal key in Settings.
DEEPSEEK_API_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3333
REDIS_CONTENT_URL=redis://127.0.0.1:6381
REDIS_CONTROL_URL=redis://127.0.0.1:6380
# CNY per day. 1 yuan permits at most 200 successful Search calls.
DAILY_BUDGET_CNY=1
SEARCH_COST_MICROYUAN=5000
SEARCH_QPS=80
SESSION_SEARCHES_PER_MINUTE=20
IP_SEARCHES_PER_MINUTE=60
SEARCH_TIMEOUT_MS=6000
SEARCH_DEADLINE_MS=10000
SNAPSHOT_TTL_SECONDS=1800
MAX_SESSION_SNAPSHOTS=20
# Set only behind a reverse proxy that REPLACES x-real-ip.
TRUST_PROXY=false
# Optional bearer token protecting /api/metrics. Keep it private.
METRICS_TOKEN=
